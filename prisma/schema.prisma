model Vendor {
  id                String         @id @default(cuid())

  // Basic Info
  name              String
  designation       String?

  email             String?
  phoneNumber       String?

  photoPath         String?
  photoUrl          String?

  numberOfProjects  Int?           @default(0)

  // Key Contact Person
  contactPerson     String?
  contactRole       String?
  contactEmail      String?
  contactPhone      String?
  contactDesignation String?

  // Extra Files & Links
  slaPath           String?
  slaUrl            String?

  documentPath      String?
  documentUrl       String?

  meetingLink       String?

  // Status
  status            VendorStatus   @default(ACTIVE)

  // Relation
  projects          Project[]

  // Audit
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("vendors")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}
