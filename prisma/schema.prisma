generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                @id @default(uuid())
  firstName               String
  lastName                String?
  username                String?               @unique
  email                   String                @unique
  passwordHash            String?
  avatarUrl               String?
  avatarUrlPath           String?
  isActive                Boolean               @default(true)
  isDeleted               Boolean               @default(false)
  role                    UserRole              @default(PROJECT_MANAGER)
  isVerified              Boolean               @default(false)
  oauthProvider           OAuthProvider         @default(email)
  oauthProviderId         String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  deletedAt               DateTime?
  forgotPasswordStatus    Boolean               @default(false)
  country                 String?
  gender                  String?
  language                String?
  timezone                String?
  tokenVersion            Int                   @default(0)
  activityLogs            ActivityLog[]         @relation("UserActivityLogs")
  emailAccounts           EmailAccount[]
  emailsApproved          Email[]               @relation("EmailApprovedBy")
  emailsCreated           Email[]               @relation("EmailCreatedBy")
  emailsDeleted           Email[]               @relation("EmailDeletedBy")
  emailsUpdated           Email[]               @relation("EmailUpdatedBy")
  employeesApproved       Employee[]            @relation("EmployeeApprovedBy")
  employeesCreated        Employee[]            @relation("EmployeeCreatedBy")
  employeesDeleted        Employee[]            @relation("EmployeeDeletedBy")
  employeesUpdated        Employee[]            @relation("EmployeeUpdatedBy")
  calendarEvents          GoogleCalendarEvent[] @relation("UserCalendarEvents")
  messages                Message[]
  notifications           Notification[]
  outlooksApproved        Outlook[]             @relation("OutlookApprovedBy")
  outlooksCreated         Outlook[]             @relation("OutlookCreatedBy")
  outlooksDeleted         Outlook[]             @relation("OutlookDeletedBy")
  outlooksUpdated         Outlook[]             @relation("OutlookUpdatedBy")
  projectAssignments      ProjectAssignment[]
  projectManagersApproved ProjectManager[]      @relation("ProjectManagerApprovedBy")
  projectManagersCreated  ProjectManager[]      @relation("ProjectManagerCreatedBy")
  projectManagersDeleted  ProjectManager[]      @relation("ProjectManagerDeletedBy")
  projectManagersUpdated  ProjectManager[]      @relation("ProjectManagerUpdatedBy")
  projectManagers         ProjectManager?
  projectsCreated         Project[]             @relation("ProjectCreatedBy")
  projectsManaged         Project[]             @relation("ProjectManager")
  projectsOwned           Project[]             @relation("ProjectOwner")
  assignedProjects        Project[]             @relation("AssignedProject")
  approvedTeams           Team[]                @relation("TeamApprovedBy")
  createdTeams            Team[]                @relation("TeamCreatedBy")
  deletedTeams            Team[]                @relation("TeamDeletedBy")
  updatedTeams            Team[]                @relation("TeamUpdatedBy")
  vendorsApproved         Vendor[]              @relation("VendorApprovedBy")
  vendorsCreated          Vendor[]              @relation("VendorCreatedBy")
  vendorsDeleted          Vendor[]              @relation("VendorDeletedBy")
  vendorsUpdated          Vendor[]              @relation("VendorUpdatedBy")
  zoomAccounts            ZoomAccount[]

  @@index([role])
  @@map("users")
}

model EmailAccount {
  id           String   @id @default(uuid())
  userId       String
  provider     String
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  createdAt    DateTime @default(now())
  email        String?
  isConnected  Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id])

  @@map("email_accounts")
}

model ActivityLog {
  id        String   @id @default(uuid())
  type      String
  crudId    String
  action    String
  userId    String
  timestamp DateTime @default(now())
  projectId String?
  project   Project? @relation("ProjectActivityLogs", fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("UserActivityLogs", fields: [userId], references: [id])

  @@map("activity_logs")
}

model Team {
  id               String          @id @default(uuid())
  name             String
  createdById      String?
  updatedById      String?
  approvedById     String?
  deletedById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  projectManagerId String?
  employees        Employee[]
  assignedProjects Project[]       @relation("AssignTeam")
  approvedBy       User?           @relation("TeamApprovedBy", fields: [approvedById], references: [id])
  createdBy        User?           @relation("TeamCreatedBy", fields: [createdById], references: [id])
  deletedBy        User?           @relation("TeamDeletedBy", fields: [deletedById], references: [id])
  projectManager   ProjectManager? @relation("PMTeams", fields: [projectManagerId], references: [id])
  updatedBy        User?           @relation("TeamUpdatedBy", fields: [updatedById], references: [id])

  @@map("teams")
}

model ProjectManager {
  id           String    @id @default(uuid())
  firstName    String    @map("firstName")
  lastName     String?   @map("lastName")
  projectId    String?   @map("project_id")
  createdById  String?   @map("created_by")
  updatedById  String?   @map("updated_by")
  approvedById String?   @map("approved_by")
  deletedById  String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("Deleted_at")
  userId       String?   @unique
  approvedBy   User?     @relation("ProjectManagerApprovedBy", fields: [approvedById], references: [id])
  createdBy    User?     @relation("ProjectManagerCreatedBy", fields: [createdById], references: [id])
  deletedBy    User?     @relation("ProjectManagerDeletedBy", fields: [deletedById], references: [id])
  updatedBy    User?     @relation("ProjectManagerUpdatedBy", fields: [updatedById], references: [id])
  user         User?     @relation(fields: [userId], references: [id])
  teams        Team[]    @relation("PMTeams")

  @@map("project_managers")
}

model Project {
  id                   String                  @id @default(uuid())
  name                 String
  description          String?
  vendorName           String?
  startDate            DateTime?
  endDate              DateTime?
  status               ProjectStatus           @default(ONGOING)
  managerId            String
  createdById          String
  deletedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  userId               String?
  weeklyMeetingSummary String?
  vendorId             String?
  assignTeamId         String?
  projectOwnerId       String?
  projectSummary       String?
  projectAiSummary     String[]                @default([])
  projectProgress      String?                 @default("0%")
  weeklyAiSummary      String?
  projectAiDetails     Json?
  cancelledReason      String?
  activityLogs         ActivityLog[]           @relation("ProjectActivityLogs")
  calendarEvents       GoogleCalendarEvent[]   @relation("ProjectCalendarEvents")
  lessonLearns         LessonLearn[]
  transcripts          MeetingTranscript[]     @relation("ProjectTranscripts")
  projectAgreements    ProjectAgreements[]
  assignments          ProjectAssignment[]
  documents            ProjectDocumentUpload[]
  health               ProjectHealth[]
  meetings             ProjectMeeting[]
  milestones           ProjectMilestone[]
  tasks                ProjectTask[]
  messages             Message[]               @relation("ProjectMessages")
  assignTeam           Team?                   @relation("AssignTeam", fields: [assignTeamId], references: [id])
  createdBy            User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  manager              User                    @relation("ProjectManager", fields: [managerId], references: [id])
  projectOwner         User?                   @relation("ProjectOwner", fields: [projectOwnerId], references: [id])
  assignedTo           User?                   @relation("AssignedProject", fields: [userId], references: [id])
  vendor               Vendor?                 @relation(fields: [vendorId], references: [id])
  raidd                Raidd[]

  @@map("projects")
}

model ProjectTask {
  id        String       @id @default(uuid())
  projectId String
  title     String
  startDate DateTime?
  endDate   DateTime?
  priority  TaskPriority
  status    TaskStatus   @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskDescription String?
  
  @@map("project_tasks")
}

model ProjectMeeting {
  id                 String        @id @default(uuid())
  projectId          String
  title              String?
  meetingUrl         String?
  meetingDate        DateTime?
  createdAt          DateTime      @default(now())
  projectSummary     String?
  lastMeetingSummary String?
  notes              String?
  agenda             Json?
  transcriptData     Json?
  transcriptPath     String?
  transcriptUrl      String?
  aiMeetingSummary   String[]      @default([])
  transcriptFileType String?
  transcriptPlayUrl  String?
  transcriptStatus   String?
  videoPlayUrl       String?
  actionPoints       ActionPoint[]
  keyPoints          KeyPoint[]
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_meetings")
}

model KeyPoint {
  id        String         @id @default(uuid())
  meetingId String
  content   String
  createdAt DateTime       @default(now())
  status    String?
  meeting   ProjectMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_key_points")
}

model ActionPoint {
  id        String         @id @default(uuid())
  meetingId String
  content   String
  createdAt DateTime       @default(now())
  status    String?
  meeting   ProjectMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_action_points")
}

model ProjectDocumentUpload {
  id                String                @id @default(uuid())
  projectId         String
  fileName          String
  fileUrl           String
  filePath          String
  createdAt         DateTime              @default(now())
  title             String?
  aiDocumentSummary String?
  setDate           DateTime?
  actionPoints      DocumentActionPoint[]
  keyPoints         DocumentKeyPoint[]
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_documents")
}

model DocumentKeyPoint {
  id         String                @id @default(uuid())
  documentId String
  content    String
  status     String?
  createdAt  DateTime              @default(now())
  document   ProjectDocumentUpload @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_key_points")
}

model DocumentActionPoint {
  id         String                @id @default(uuid())
  documentId String
  content    String
  status     String?
  createdAt  DateTime              @default(now())
  document   ProjectDocumentUpload @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_action_points")
}

model ProjectAgreements {
  id        String   @id @default(uuid())
  projectId String
  fileName  String
  fileUrl   String
  filePath  String
  createdAt DateTime @default(now())
  fileType  String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_agreements")
}

model ProjectMilestone {
  id            String          @id @default(uuid())
  projectId     String
  title         String
  description   String?
  milestoneDate DateTime
  status        MilestoneStatus
  createdAt     DateTime        @default(now())
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_milestones")
}

model ProjectAssignment {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_assignments")
}

model ProjectHealth {
  id           String        @id @default(uuid())
  projectId    String
  score        Int?
  status       String?
  createdAt    DateTime      @default(now())
  healthStatus HealthStatus?
  type         HealthType?
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_health")
}

model MeetingTranscript {
  id         String   @id @default(uuid())
  meetingId  String?
  platform   String
  fileName   String
  filePath   String
  fileType   String
  parsedData Json
  createdAt  DateTime @default(now())
  projectId  String?
  project    Project? @relation("ProjectTranscripts", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("meeting_transcripts")
}

model Vendor {
  id                 String    @id @default(uuid())
  name               String
  designation        String?
  email              String?
  phone              String?
  numberOfProjects   Int?      @default(0)
  photoUrl           String?
  photoPath          String?
  contactPerson      String?
  contactRole        String?
  contactEmail       String?
  contactPhone       String?
  contactProjects    Int?      @default(0)
  contactDesignation String?
  meetingLinks       Json?     @default("[]")
  documents          Json?     @default("[]")
  slas               Json?     @default("[]")
  vendorAiResponse   Json?
  created_by         String?
  updated_by         String?
  approved_by        String?
  deleted_by         String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("Deleted_at")
  emails             Email[]
  outlooks           Outlook[]
  projects           Project[]
  approvedBy         User?     @relation("VendorApprovedBy", fields: [approved_by], references: [id])
  createdBy          User?     @relation("VendorCreatedBy", fields: [created_by], references: [id])
  deletedBy          User?     @relation("VendorDeletedBy", fields: [deleted_by], references: [id])
  updatedBy          User?     @relation("VendorUpdatedBy", fields: [updated_by], references: [id])

  @@map("vendors")
}

model Email {
  id             String    @id @default(uuid())
  subject        String?
  body           String?
  senderEmail    String
  receiverEmail  String?
  vendorEmail    String?
  vendorId       String?
  created_by     String?
  updated_by     String?
  approved_by    String?
  deleted_by     String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("Deleted_at")
  gmailMessageId String?
  category       String?
  receivedAt     DateTime?
  source         String?
  tasks          Json?
  sentiment      String?
  decisions      Json?
  raiddAnalysis  Json?
  raiddMessage   String?
  emailRawId     String?
  fullAiResponse Json?
  generatedReply Json?
  approvedBy     User?     @relation("EmailApprovedBy", fields: [approved_by], references: [id])
  createdBy      User?     @relation("EmailCreatedBy", fields: [created_by], references: [id])
  deletedBy      User?     @relation("EmailDeletedBy", fields: [deleted_by], references: [id])
  updatedBy      User?     @relation("EmailUpdatedBy", fields: [updated_by], references: [id])
  vendor         Vendor?   @relation(fields: [vendorId], references: [id])

  @@unique([gmailMessageId, receiverEmail])
  @@map("emails")
}

model Outlook {
  id               String    @id @default(uuid())
  subject          String?
  body             String?
  senderEmail      String
  receiverEmail    String?
  vendorEmail      String?
  outlookMessageId String?
  category         String?
  receivedAt       DateTime?
  vendorId         String?
  created_by       String?
  updated_by       String?
  approved_by      String?
  deleted_by       String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("Deleted_at")
  source           String?
  tasks            Json?
  sentiment        String?
  decisions        Json?
  raiddAnalysis    Json?
  raiddMessage      String?
  outlookRawId      String?
  fullAiResponse    Json?
  generatedReply    Json?
  approvedBy        User?     @relation("OutlookApprovedBy", fields: [approved_by], references: [id])
  createdBy        User?     @relation("OutlookCreatedBy", fields: [created_by], references: [id])
  deletedBy        User?     @relation("OutlookDeletedBy", fields: [deleted_by], references: [id])
  updatedBy        User?     @relation("OutlookUpdatedBy", fields: [updated_by], references: [id])
  vendor           Vendor?   @relation(fields: [vendorId], references: [id])

  @@unique([outlookMessageId, receiverEmail])
  @@map("outlooks")
}

model AiDetection {
  id            String    @id @default(uuid())
  title         String
  summary       String?
  sourceType    String
  managerId     String?
  createdBy     String
  updatedBy     String?
  approvedBy    String?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  raiddAnalysis Json?
  raiddMessage  String?
  fullAiResponse Json?

  @@map("AI_detection")
}

model Raidd {
  id          String       @id @default(uuid())
  projectId   String
  title       String?
  description String?
  type        RaiddType
  status      RaiddStatus?
  created_by  String
  updated_by  String?
  approved_by String?
  deleted_by  String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  deleted_at  DateTime?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("raidd")
}

model Employee {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String?
  email       String    @unique
  phoneNumber String?
  teamId      String?
  created_by  String
  updated_by  String?
  approved_by String?
  deleted_by  String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("Deleted_at")
  designation String?
  approvedBy  User?     @relation("EmployeeApprovedBy", fields: [approved_by], references: [id])
  createdBy   User      @relation("EmployeeCreatedBy", fields: [created_by], references: [id])
  deletedBy   User?     @relation("EmployeeDeletedBy", fields: [deleted_by], references: [id])
  team        Team?     @relation(fields: [teamId], references: [id])
  updatedBy   User?     @relation("EmployeeUpdatedBy", fields: [updated_by], references: [id])

  @@map("employees")
}

model ZoomAccount {
  id              String   @id @default(uuid())
  zoomUserId      String
  zoomEmail       String
  accessToken     String
  refreshToken    String
  tokenExpiry     DateTime
  connectedUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [connectedUserId], references: [id])

  @@map("zoom_accounts")
}

model ZoomAuthState {
  id        String   @id @default(uuid())
  state     String   @unique
  userId    String
  createdAt DateTime @default(now())
}

model LessonLearn {
  id                        String    @id @default(uuid())
  projectId                 String
  projectName               String
  clientName                String?
  title                     String?
  description               String?
  source                    String?
  loggedDate                DateTime?
  created_by                String?
  updated_by                String?
  approved_by               String?
  deleted_by                String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  deleted_at                DateTime?
  actionable_warnings       Json?
  aiResponse                Json?
  current_situation_summary String?
  historical_insights       Json?
  status                    String?
  project                   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("lesson_learns")
}

model GoogleCalendarEvent {
  id            String    @id @default(uuid())
  googleEventId String    @unique @map("google_event_id")
  summary       String?
  description   String?
  location      String?
  start         DateTime
  end           DateTime
  htmlLink      String?   @map("html_link")
  userId        String    @map("user_id")
  projectId     String?   @map("project_id")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  project       Project?  @relation("ProjectCalendarEvents", fields: [projectId], references: [id], onDelete: Cascade)
  user          User      @relation("UserCalendarEvents", fields: [userId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@map("google_calendar_events")
}

model Message {
  id           String     @id @default(uuid())
  userId       String
  content      String
  sender       SenderType
  agentName    String?
  createdAt    DateTime   @default(now())
  documentPath String?
  documentUrl  String?
  sessionId    String?
  projectId    String?
  user         User       @relation(fields: [userId], references: [id])
  project      Project?   @relation("ProjectMessages", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("messages")
}


enum UserRole {
  SYSTEM_OWNER    @map("system_owner")
  BUSINESS_OWNER  @map("business_owner")
  ADMIN           @map("admin")
  PROJECT_MANAGER @map("project_manager")
}

enum OAuthProvider {
  email
  google
  facebook
  apple
}

enum RaiddType {
  RISK
  ASSUMPTION
  ISSUE
  DECISION
  DEPENDENCY
}

enum RaiddStatus {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  ONGOING
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  QA
  CLIENT
}

enum HealthType {
  OVERALL_STATUS
  BUDGET_STATUS
  TEAM_SENTIMENT
  TASK_STATUS
}

enum HealthStatus {
  ON_TRACK
  PENDING
  AT_RISK
  OFF_TRACK
  GOOD
  EXCELLENT
  LOW
  BAD
  NORMAL
  PERFECT
}

enum SenderType {
  USER
  AGENT
}


model Notification {
  id           String             @id @default(uuid())
  userId       String
  title        String
  message      String
  type         NotificationType
  status       NotificationStatus @default(UNREAD)
  link         String?
  entityId     String?
  reminderType String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id])

  @@map("notifications")
}
enum NotificationType {
  CALENDAR_EVENT
  ZOOM_MEETING
  SYSTEM
}

enum NotificationStatus {
  READ
  UNREAD
}
