generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                @id @default(uuid())
  firstName               String
  lastName                String?
  username                String?               @unique
  email                   String                @unique
  passwordHash            String?
  avatarUrl               String?
  avatarUrlPath           String?
  isActive                Boolean               @default(true)
  isDeleted               Boolean               @default(false)
  role                    UserRole              @default(PROJECT_MANAGER)
  isVerified              Boolean               @default(false)
  oauthProvider           OAuthProvider         @default(email)
  oauthProviderId         String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  deletedAt               DateTime?
  forgotPasswordStatus    Boolean               @default(false)
  country                 String?
  gender                  String?
  language                String?
  timezone                String?
  tokenVersion            Int                   @default(0)
  activityLogs            ActivityLog[]         @relation("UserActivityLogs")
  emailAccounts           EmailAccount[]
  emailsApproved          Email[]               @relation("EmailApprovedBy")
  emailsCreated           Email[]               @relation("EmailCreatedBy")
  emailsDeleted           Email[]               @relation("EmailDeletedBy")
  emailsUpdated           Email[]               @relation("EmailUpdatedBy")
  employeesApproved       Employee[]            @relation("EmployeeApprovedBy")
  employeesCreated        Employee[]            @relation("EmployeeCreatedBy")
  employeesDeleted        Employee[]            @relation("EmployeeDeletedBy")
  employeesUpdated        Employee[]            @relation("EmployeeUpdatedBy")
  calendarEvents          GoogleCalendarEvent[] @relation("UserCalendarEvents")
  messages                Message[]
  notifications           Notification[]
  outlooksApproved        Outlook[]             @relation("OutlookApprovedBy")
  outlooksCreated         Outlook[]             @relation("OutlookCreatedBy")
  outlooksDeleted         Outlook[]             @relation("OutlookDeletedBy")
  outlooksUpdated         Outlook[]             @relation("OutlookUpdatedBy")
  projectAssignments      ProjectAssignment[]
  projectManagersApproved ProjectManager[]      @relation("ProjectManagerApprovedBy")
  projectManagersCreated  ProjectManager[]      @relation("ProjectManagerCreatedBy")
  projectManagersDeleted  ProjectManager[]      @relation("ProjectManagerDeletedBy")
  projectManagersUpdated  ProjectManager[]      @relation("ProjectManagerUpdatedBy")
  projectManagers         ProjectManager?
  projectsCreated         Project[]             @relation("ProjectCreatedBy")
  projectsManaged         Project[]             @relation("ProjectManager")
  projectsOwned           Project[]             @relation("ProjectOwner")
  assignedProjects        Project[]             @relation("AssignedProject")
  approvedTeams           Team[]                @relation("TeamApprovedBy")
  createdTeams            Team[]                @relation("TeamCreatedBy")
  deletedTeams            Team[]                @relation("TeamDeletedBy")
  updatedTeams            Team[]                @relation("TeamUpdatedBy")
  clientsApproved         Client[]              @relation("ClientApprovedBy")
  clientsCreated          Client[]              @relation("ClientCreatedBy")
  clientsDeleted          Client[]              @relation("ClientDeletedBy")
  clientsUpdated          Client[]              @relation("ClientUpdatedBy")
  zoomAccounts            ZoomAccount[]

  @@index([role])
  @@map("users")
}

model EmailAccount {
  id           String   @id @default(uuid())
  userId       String
  provider     String
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  createdAt    DateTime @default(now())
  email        String?
  isConnected  Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id])

  @@map("email_accounts")
}

model ActivityLog {
  id        String   @id @default(uuid())
  type      String
  crudId    String
  action    String
  userId    String
  timestamp DateTime @default(now())
  projectId String?
  project   Project? @relation("ProjectActivityLogs", fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("UserActivityLogs", fields: [userId], references: [id])

  @@map("activity_logs")
}

model Team {
  id               String          @id @default(uuid())
  name             String
  createdById      String?
  updatedById      String?
  approvedById     String?
  deletedById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  projectManagerId String?
  employees        Employee[]
  assignedProjects Project[]       @relation("AssignTeam")
  approvedBy       User?           @relation("TeamApprovedBy", fields: [approvedById], references: [id])
  createdBy        User?           @relation("TeamCreatedBy", fields: [createdById], references: [id])
  deletedBy        User?           @relation("TeamDeletedBy", fields: [deletedById], references: [id])
  projectManager   ProjectManager? @relation("PMTeams", fields: [projectManagerId], references: [id])
  updatedBy        User?           @relation("TeamUpdatedBy", fields: [updatedById], references: [id])

  @@map("teams")
}

model ProjectManager {
  id           String    @id @default(uuid())
  firstName    String    @map("firstName")
  lastName     String?   @map("lastName")
  projectId    String?   @map("project_id")
  createdById  String?   @map("created_by")
  updatedById  String?   @map("updated_by")
  approvedById String?   @map("approved_by")
  deletedById  String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("Deleted_at")
  userId       String?   @unique
  approvedBy   User?     @relation("ProjectManagerApprovedBy", fields: [approvedById], references: [id])
  createdBy    User?     @relation("ProjectManagerCreatedBy", fields: [createdById], references: [id])
  deletedBy    User?     @relation("ProjectManagerDeletedBy", fields: [deletedById], references: [id])
  updatedBy    User?     @relation("ProjectManagerUpdatedBy", fields: [updatedById], references: [id])
  user         User?     @relation(fields: [userId], references: [id])
  teams        Team[]    @relation("PMTeams")

  @@map("project_managers")
}

model Project {
  id                   String                  @id @default(uuid())
  name                 String
  description          String?
  clientName           String?
  startDate            DateTime?
  endDate              DateTime?
  status               ProjectStatus           @default(ONGOING)
  managerId            String
  createdById          String
  deletedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  userId               String?
  weeklyMeetingSummary String?
  clientId             String?
  assignTeamId         String?
  projectOwnerId       String?
  projectAiSummary     String[]                @default([])
  projectProgress      String?                 @default("0%")
  projectAiDetails     Json?
  aiCheck              Boolean                 @default(false)
  discussionPoints     String[]                @default([])
  actionPoints         String[]                @default([])
  cancelledReason      String?
  notes                String?
  activityLogs         ActivityLog[]           @relation("ProjectActivityLogs")
  calendarEvents       GoogleCalendarEvent[]   @relation("ProjectCalendarEvents")
  lessonLearns         LessonLearn[]
  transcripts          MeetingTranscript[]     @relation("ProjectTranscripts")
  projectAgreements    ProjectAgreements[]
  assignments          ProjectAssignment[]
  documents            ProjectDocumentUpload[]
  projectHealth        String?
  meetings             ProjectMeeting[]
  milestones           ProjectMilestone[]
  tasks                ProjectTask[]
  weeklyAiSummaries    WeeklyAiSummary[]
  messages             Message[]               @relation("ProjectMessages")
  assignTeam           Team?                   @relation("AssignTeam", fields: [assignTeamId], references: [id])
  createdBy            User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  manager              User                    @relation("ProjectManager", fields: [managerId], references: [id])
  projectOwner         User?                   @relation("ProjectOwner", fields: [projectOwnerId], references: [id])
  assignedTo           User?                   @relation("AssignedProject", fields: [userId], references: [id])
  client               Client?                 @relation(fields: [clientId], references: [id])
  vendorId             String?
  vendor               Vendor?                 @relation(fields: [vendorId], references: [id])
  raidd                Raidd[]
  risks                ProjectRisk[]
  assumptions          ProjectAssumption[]
  issues               ProjectIssue[]
  decisions            ProjectDecision[]
  dependencies         ProjectDependency[]

  @@map("projects")
}

model ProjectTask {
  id              String       @id @default(uuid())
  projectId       String
  title           String
  startDate       DateTime?
  endDate         DateTime?
  priority        TaskPriority
  status          TaskStatus   @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskDescription String?

  @@map("project_tasks")
}

model ProjectMeeting {
  id                 String        @id @default(uuid())
  projectId          String
  title              String?
  meetingUrl         String?
  meetingDate        DateTime?
  createdAt          DateTime      @default(now())
  projectSummary     String?
  lastMeetingSummary String?
  notes              String?
  agenda             Json?
  transcriptData     Json?
  transcriptPath     String?
  transcriptUrl      String?
  aiMeetingSummary   String[]      @default([])
  transcriptFileType String?
  transcriptPlayUrl  String?
  transcriptStatus   String?
  aiCheck            Boolean       @default(false)
  videoPlayUrl       String?
  rawAiResponse      Json?
  actionPoints       ActionPoint[]
  keyPoints          KeyPoint[]
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_meetings")
}

model KeyPoint {
  id        String         @id @default(uuid())
  meetingId String
  content   String
  createdAt DateTime       @default(now())
  status    String?
  meeting   ProjectMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_key_points")
}

model ActionPoint {
  id        String         @id @default(uuid())
  meetingId String
  content   String
  createdAt DateTime       @default(now())
  status    String?
  meeting   ProjectMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_action_points")
}

model ProjectDocumentUpload {
  id                String                @id @default(uuid())
  projectId         String
  fileName          String
  fileUrl           String
  filePath          String
  createdAt         DateTime              @default(now())
  title             String?
  aiDocumentSummary String?
  setDate           DateTime?
  aiCheck           Boolean               @default(false)
  actionPoints      DocumentActionPoint[]
  keyPoints         DocumentKeyPoint[]
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_documents")
}

model DocumentKeyPoint {
  id         String                @id @default(uuid())
  documentId String
  content    String
  status     String?
  createdAt  DateTime              @default(now())
  document   ProjectDocumentUpload @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_key_points")
}

model DocumentActionPoint {
  id         String                @id @default(uuid())
  documentId String
  content    String
  status     String?
  createdAt  DateTime              @default(now())
  document   ProjectDocumentUpload @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_action_points")
}

model ProjectAgreements {
  id        String   @id @default(uuid())
  projectId String
  fileName  String
  fileUrl   String
  filePath  String
  createdAt DateTime @default(now())
  fileType  String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_agreements")
}

model ProjectMilestone {
  id            String          @id @default(uuid())
  projectId     String
  title         String
  description   String?
  startDate     DateTime?
  milestoneDate DateTime
  status        MilestoneStatus
  createdAt     DateTime        @default(now())
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_milestones")
}

model ProjectAssignment {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_assignments")
}

model MeetingTranscript {
  id         String   @id @default(uuid())
  meetingId  String?
  platform   String
  fileName   String
  filePath   String
  fileType   String
  parsedData Json
  createdAt  DateTime @default(now())
  projectId  String?
  project    Project? @relation("ProjectTranscripts", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("meeting_transcripts")
}

model Client {
  id                 String    @id @default(uuid())
  name               String
  designation        String?
  email              String?
  phone              String?
  numberOfProjects   Int?      @default(0)
  photoUrl           String?
  photoPath          String?
  contactPerson      String?
  contactRole        String?
  contactEmail       String?
  contactPhone       String?
  contactProjects    Int?      @default(0)
  contactDesignation String?
  meetingLinks       Json?     @default("[]")
  documents          Json?     @default("[]")
  slas               Json?     @default("[]")
  clientAiResponse   Json?
  created_by         String?
  updated_by         String?
  approved_by        String?
  deleted_by         String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("Deleted_at")
  emails             Email[]
  outlooks           Outlook[]
  projects           Project[]
  approvedBy         User?     @relation("ClientApprovedBy", fields: [approved_by], references: [id])
  createdBy          User?     @relation("ClientCreatedBy", fields: [created_by], references: [id])
  deletedBy          User?     @relation("ClientDeletedBy", fields: [deleted_by], references: [id])
  updatedBy          User?     @relation("ClientUpdatedBy", fields: [updated_by], references: [id])

  @@map("clients")
}

model Email {
  id                  String              @id @default(uuid())
  subject             String?
  body                String?
  senderEmail         String
  receiverEmail       String?
  clientEmail         String?
  clientId            String?
  created_by          String?
  updated_by          String?
  approved_by         String?
  deleted_by          String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("Deleted_at")
  gmailMessageId      String?
  category            String?
  receivedAt          DateTime?
  source              String?
  tasks               Json?
  sentiment           String?
  decisions           Json?
  raiddAnalysis       Json?
  raiddData           Json?
  raiddMessage        String?
  emailRawId          String?
  fullAiResponse      Json?
  generatedReply      Json?
  aiCheck             Boolean             @default(false)
  approvedBy          User?               @relation("EmailApprovedBy", fields: [approved_by], references: [id])
  createdBy           User?               @relation("EmailCreatedBy", fields: [created_by], references: [id])
  deletedBy           User?               @relation("EmailDeletedBy", fields: [deleted_by], references: [id])
  updatedBy           User?               @relation("EmailUpdatedBy", fields: [updated_by], references: [id])
  client              Client?             @relation(fields: [clientId], references: [id])
  aiDetections        AiDetection[]
  projectRisks        ProjectRisk[]
  projectAssumptions  ProjectAssumption[]
  projectIssues       ProjectIssue[]
  projectDecisions    ProjectDecision[]
  projectDependencies ProjectDependency[]

  @@unique([gmailMessageId, receiverEmail])
  @@map("emails")
}

model Outlook {
  id                  String              @id @default(uuid())
  subject             String?
  body                String?
  senderEmail         String
  receiverEmail       String?
  clientEmail         String?
  outlookMessageId    String?
  category            String?
  receivedAt          DateTime?
  clientId            String?
  created_by          String?
  updated_by          String?
  approved_by         String?
  deleted_by          String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("Deleted_at")
  source              String?
  tasks               Json?
  sentiment           String?
  decisions           Json?
  raiddAnalysis       Json?
  raiddData           Json?
  raiddMessage        String?
  outlookRawId        String?
  fullAiResponse      Json?
  generatedReply      Json?
  aiCheck             Boolean             @default(false)
  approvedBy          User?               @relation("OutlookApprovedBy", fields: [approved_by], references: [id])
  createdBy           User?               @relation("OutlookCreatedBy", fields: [created_by], references: [id])
  deletedBy           User?               @relation("OutlookDeletedBy", fields: [deleted_by], references: [id])
  updatedBy           User?               @relation("OutlookUpdatedBy", fields: [updated_by], references: [id])
  client              Client?             @relation(fields: [clientId], references: [id])
  aiDetections        AiDetection[]
  projectRisks        ProjectRisk[]
  projectAssumptions  ProjectAssumption[]
  projectIssues       ProjectIssue[]
  projectDecisions    ProjectDecision[]
  projectDependencies ProjectDependency[]

  @@unique([outlookMessageId, receiverEmail])
  @@map("outlooks")
}

model AiDetection {
  id                  String              @id @default(uuid())
  title               String
  summary             String?
  sourceType          String
  managerId           String?
  createdBy           String
  updatedBy           String?
  approvedBy          String?
  deletedBy           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  raiddAnalysis       Json?
  raiddData           Json?
  raiddMessage        String?
  fullAiResponse      Json?
  emailId             String?
  outlookId           String?
  email               Email?              @relation(fields: [emailId], references: [id])
  outlook             Outlook?            @relation(fields: [outlookId], references: [id])
  raidds              Raidd[]
  projectRisks        ProjectRisk[]
  projectAssumptions  ProjectAssumption[]
  projectIssues       ProjectIssue[]
  projectDecisions    ProjectDecision[]
  projectDependencies ProjectDependency[]

  @@map("AI_detection")
}

model Raidd {
  id                          String              @id @default(uuid())
  projectId                   String
  title                       String?
  description                 Json?
  type                        RaiddType[]
  status                      RaiddStatus?
  assumptionValidationDueDate DateTime?
  decisionDueDate             DateTime?
  decisionOwner               String?
  created_by                  String
  updated_by                  String?
  approved_by                 String?
  deleted_by                  String?
  created_at                  DateTime            @default(now())
  updated_at                  DateTime            @updatedAt
  deleted_at                  DateTime?
  project                     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiDetectionId               String?
  aiDetection                 AiDetection?        @relation(fields: [aiDetectionId], references: [id])
  risks                       ProjectRisk[]
  assumptions                 ProjectAssumption[]
  issues                      ProjectIssue[]
  decisions                   ProjectDecision[]
  dependencies                ProjectDependency[]

  @@map("raidd")
}

model Employee {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String?
  email       String    @unique
  phoneNumber String?
  teamId      String?
  created_by  String
  updated_by  String?
  approved_by String?
  deleted_by  String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("Deleted_at")
  designation String?
  approvedBy  User?     @relation("EmployeeApprovedBy", fields: [approved_by], references: [id])
  createdBy   User      @relation("EmployeeCreatedBy", fields: [created_by], references: [id])
  deletedBy   User?     @relation("EmployeeDeletedBy", fields: [deleted_by], references: [id])
  team        Team?     @relation(fields: [teamId], references: [id])
  updatedBy   User?     @relation("EmployeeUpdatedBy", fields: [updated_by], references: [id])

  @@map("employees")
}

model ZoomAccount {
  id              String   @id @default(uuid())
  zoomUserId      String
  zoomEmail       String
  accessToken     String
  refreshToken    String
  tokenExpiry     DateTime
  connectedUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [connectedUserId], references: [id])

  @@map("zoom_accounts")
}

model ZoomAuthState {
  id        String   @id @default(uuid())
  state     String   @unique
  userId    String
  createdAt DateTime @default(now())
}

model LessonLearn {
  id                        String    @id @default(uuid())
  projectId                 String
  projectName               String
  clientName                String?
  title                     String?
  description               String?
  source                    String?
  loggedDate                DateTime?
  created_by                String?
  updated_by                String?
  approved_by               String?
  deleted_by                String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  deleted_at                DateTime?
  actionable_warnings       Json?
  aiResponse                Json?
  current_situation_summary String?
  historical_insights       Json?
  status                    String?
  project                   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("lesson_learns")
}

model GoogleCalendarEvent {
  id            String    @id @default(uuid())
  googleEventId String    @unique @map("google_event_id")
  summary       String?
  description   String?
  location      String?
  start         DateTime
  end           DateTime
  htmlLink      String?   @map("html_link")
  userId        String    @map("user_id")
  projectId     String?   @map("project_id")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  project       Project?  @relation("ProjectCalendarEvents", fields: [projectId], references: [id], onDelete: Cascade)
  user          User      @relation("UserCalendarEvents", fields: [userId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@map("google_calendar_events")
}

model Message {
  id           String     @id @default(uuid())
  userId       String
  content      String
  sender       SenderType
  agentName    String?
  createdAt    DateTime   @default(now())
  documentPath String?
  documentUrl  String?
  sessionId    String?
  projectId    String?
  user         User       @relation(fields: [userId], references: [id])
  project      Project?   @relation("ProjectMessages", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("messages")
}

enum UserRole {
  SYSTEM_OWNER    @map("system_owner")
  BUSINESS_OWNER  @map("business_owner")
  ADMIN           @map("admin")
  PROJECT_MANAGER @map("project_manager")
}

enum OAuthProvider {
  email
  google
  facebook
  apple
}

enum RaiddType {
  RISK
  ASSUMPTION
  ISSUE
  DECISION
  DEPENDENCY
}

enum RaiddStatus {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  ONGOING
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
  BLOCKED
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  QA
  CLIENT
}

enum SenderType {
  USER
  AGENT
}

model Notification {
  id           String             @id @default(uuid())
  userId       String
  title        String
  message      String
  type         NotificationType
  status       NotificationStatus @default(UNREAD)
  link         String?
  entityId     String?
  reminderType String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id])

  @@map("notifications")
}

enum NotificationType {
  CALENDAR_EVENT
  ZOOM_MEETING
  SYSTEM
}

enum NotificationStatus {
  READ
  UNREAD
}

model WeeklyAiSummary {
  id              String    @id @default(uuid())
  projectId       String
  weeklyAiSummary String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("weekly_ai_summaries")
}

model ProjectRisk {
  id            String       @id @default(uuid())
  projectId     String?
  raiddId       String?
  emailId       String?
  outlookId     String?
  aiDetectionId String?
  data          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raidd         Raidd?       @relation(fields: [raiddId], references: [id], onDelete: Cascade)
  email         Email?       @relation(fields: [emailId], references: [id])
  outlook       Outlook?     @relation(fields: [outlookId], references: [id])
  aiDetection   AiDetection? @relation(fields: [aiDetectionId], references: [id])

  @@map("project_risks")
}

model ProjectAssumption {
  id            String       @id @default(uuid())
  projectId     String?
  raiddId       String?
  emailId       String?
  outlookId     String?
  aiDetectionId String?
  data          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raidd         Raidd?       @relation(fields: [raiddId], references: [id], onDelete: Cascade)
  email         Email?       @relation(fields: [emailId], references: [id])
  outlook       Outlook?     @relation(fields: [outlookId], references: [id])
  aiDetection   AiDetection? @relation(fields: [aiDetectionId], references: [id])

  @@map("project_assumptions")
}

